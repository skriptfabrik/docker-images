FROM ghcr.io/skriptfabrik/fileenv:1.2.0 AS fileenv

FROM n8nio/n8n-sandbox-service-runner-dind:1.3.2

# Exclude "_FILE" suffixed environment variables from being processed by fileenv, as
# they are already handled natively by the sandbox runner (TLS certificate/key paths,
# not generic secret references).
ENV FILEENV_EXCLUDE="SANDBOX_RUNNER_CONTROL_GRPC_TLS_CERT_FILE,SANDBOX_RUNNER_CONTROL_GRPC_TLS_CLIENT_CA_FILE,SANDBOX_RUNNER_CONTROL_GRPC_TLS_KEY_FILE,SANDBOX_RUNNER_REGISTRATION_GRPC_CA_FILE,SANDBOX_RUNNER_REGISTRATION_GRPC_CERT_FILE,SANDBOX_RUNNER_REGISTRATION_GRPC_KEY_FILE"

COPY --from=fileenv /usr/local/bin/fileenv /usr/local/bin/fileenv

ENTRYPOINT ["/usr/local/bin/fileenv", "/sbin/tini", "--", "/usr/local/bin/start-runner.sh"]
