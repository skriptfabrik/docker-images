FROM ghcr.io/skriptfabrik/fileenv:1.2.0 AS fileenv

FROM ghcr.io/usekaneo/kaneo:2.50.0

ENV FILEENV_EXCLUDE="AUTH_SECRET_FILE,CREEM_API_KEY_FILE,CREEM_WEBHOOK_SECRET_FILE,CUSTOM_OAUTH_CLIENT_SECRET_FILE,GITHUB_CLIENT_SECRET_FILE,GITHUB_OAUTH_CLIENT_SECRET_FILE,GITHUB_PRIVATE_KEY_BASE64_FILE,GITHUB_PRIVATE_KEY_FILE,GITHUB_WEBHOOK_SECRET_FILE,NOTIFICATION_SECRET_ENCRYPTION_KEY_FILE,POSTGRES_PASSWORD_FILE,S3_ACCESS_KEY_ID_FILE,S3_SECRET_ACCESS_KEY_FILE,SMTP_PASSWORD_FILE,TURNSTILE_SECRET_KEY_FILE"

COPY --from=fileenv /usr/local/bin/fileenv /usr/local/bin/fileenv

ENTRYPOINT ["/usr/local/bin/fileenv"]

CMD ["/usr/local/bin/kaneo-entrypoint.sh"]
