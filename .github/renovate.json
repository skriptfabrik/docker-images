{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "customManagers:dockerfileVersions",
    ":disableRateLimiting",
    ":gitSignOff",
    ":semanticCommits",
    ":semanticPrefixChore",
    ":semanticCommitScopeDisabled"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Berlin",
  "enabledManagers": [
    "custom.regex",
    "devcontainer",
    "dockerfile",
    "github-actions",
    "mise",
    "npm"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Devcontainer feature versions annotated with renovate comments",
      "managerFilePatterns": ["/^\\.devcontainer/devcontainer\\.json$/"],
      "matchStrings": [
        "//\\s*renovate:\\s*datasource=(?<datasource>\\S+)\\s+depName=(?<depName>\\S+)\\s*\\n\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "skriptfabrik",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "skriptfabrik",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Devcontainer updates are applied on Sundays",
      "matchManagers": ["devcontainer"],
      "addLabels": ["devcontainer"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "Devcontainer feature versions are updated on Sundays, final releases only",
      "matchManagers": ["custom.regex"],
      "matchFileNames": [".devcontainer/devcontainer.json"],
      "allowedVersions": "/^\\d+\\.\\d+\\.\\d+$/",
      "addLabels": ["devcontainer"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "Dockerfile updates for custom regex are applied early in the day",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["**/Dockerfile", "**/Dockerfile.*"],
      "addLabels": ["docker"],
      "schedule": ["* 0-3 * * *"]
    },
    {
      "description": "Dockerfile updates for general images are updated early in the day",
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"],
      "schedule": ["* 0-3 * * *"]
    },
    {
      "description": "GitHub Actions are updated on Sundays",
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "Tools pinned via mise are updated on Sundays",
      "matchManagers": ["mise"],
      "addLabels": ["mise"],
      "schedule": ["* * * * 0"]
    },
    {
      "description": "JavaScript dependencies are updated on Mondays once released for a day",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"],
      "minimumReleaseAge": "1 day",
      "schedule": ["* * * * 1"]
    },
    {
      "description": "Lock file maintenance runs early on Mondays without a release age",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null,
      "schedule": ["* 0-3 * * 1"]
    },
    {
      "description": "Dockerfile updates for Arcane images are grouped together",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/getarcaneapp/*"],
      "groupName": "arcane"
    },
    {
      "description": "Dockerfile updates for n8n images are grouped together",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["n8nio/n8n", "n8nio/runners"],
      "groupName": "n8n"
    },
    {
      "description": "Dockerfile updates for n8n sandbox service images are grouped together",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["n8nio/n8n-sandbox-service-*"],
      "groupName": "n8n-sandbox-service"
    },
    {
      "description": "Dockerfile updates for Plane images are grouped together",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["makeplane/*"],
      "groupName": "plane"
    },
    {
      "description": "Dockerfile updates for Traefik images are grouped together",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": [
        "traefik",
        "maxlerebourg/crowdsec-bouncer-traefik-plugin"
      ],
      "groupName": "traefik"
    },
    {
      "description": "Commitlint npm dependencies are grouped under 'commitlint'",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@commitlint/*"],
      "minimumReleaseAge": "1 day",
      "groupName": "commitlint"
    }
  ]
}
