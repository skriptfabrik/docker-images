{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [":gitSignOff", "customManagers:dockerfileVersions"],
  "enabledManagers": [
    "custom.regex",
    "devcontainer",
    "dockerfile",
    "github-actions",
    "mise",
    "npm"
  ],
  "labels": ["dependencies"],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "docker.io",
      "username": "skriptfabrik",
      "password": "{{ secrets.DOCKERHUB_TOKEN }}"
    },
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "skriptfabrik",
      "password": "{{ secrets.GHCR_TOKEN }}"
    }
  ],
  "mise": {
    "lockFileMaintenance": {
      "enabled": true,
      "schedule": ["at any time"]
    }
  },
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "addLabels": ["docker"],
      "schedule": ["* 0-3 * * *"]
    },
    {
      "matchManagers": ["devcontainer"],
      "addLabels": ["devcontainer"],
      "schedule": ["* * * * 0"]
    },
    {
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"],
      "schedule": ["* 0-3 * * *"]
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["ghcr.io/getarcaneapp/*"],
      "groupName": "arcane"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["n8nio/n8n", "n8nio/runners"],
      "groupName": "n8n"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["n8nio/n8n-sandbox-service-*"],
      "groupName": "n8n-sandbox-service"
    },
    {
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["makeplane/*"],
      "groupName": "plane"
    },
    {
      "matchPackageNames": [
        "traefik",
        "maxlerebourg/crowdsec-bouncer-traefik-plugin"
      ],
      "groupName": "traefik"
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "schedule": ["* * * * 0"]
    },
    {
      "matchManagers": ["mise"],
      "addLabels": ["mise"],
      "schedule": ["* * * * 0"]
    },
    {
      "matchManagers": ["npm"],
      "addLabels": ["javascript"],
      "minimumReleaseAge": "1 day",
      "schedule": ["* * * * 1"]
    },
    {
      "matchManagers": ["npm"],
      "matchPackageNames": ["@commitlint/*"],
      "minimumReleaseAge": "1 day",
      "groupName": "commitlint"
    }
  ],
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "timezone": "Europe/Berlin"
}
